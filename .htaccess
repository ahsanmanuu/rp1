# DO NOT REMOVE. CLOUDLINUX PASSED AGENT CONFIGURATION BEGIN
PassengerAppRoot "/home/latexify/latexify"
PassengerBaseURI "/"
PassengerNodejs "/home/latexify/nodevenv/latexify/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSED AGENT CONFIGURATION END

# LiteSpeed & Apache Configuration for Node.js Application
DirectoryIndex app.js app.cjs index.php

# Enable LiteSpeed & Apache Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Aggressive Browser Caching for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|gif|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Explicitly grant access permissions for LiteSpeed Web Server
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Protect sensitive environment and database files
<FilesMatch "^\.(env|git|cpanel|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Forward SSL protocol headers
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set X-Forwarded-Proto header for HTTPS connections
    RewriteCond %{HTTPS} on
    RewriteRule .* - [E=HTTP_X_FORWARDED_PROTO:https]
</IfModule>


