# LiteSpeed & Apache Configuration for Node.js Application
DirectoryIndex index.html index.php app.cjs app.js

# Explicitly grant access permissions for LiteSpeed Web Server
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Protect sensitive environment and database files
<FilesMatch "^\.(env|git|cpanel|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Forward SSL protocol headers & handle reverse proxy fallback
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set X-Forwarded-Proto header for HTTPS connections
    RewriteCond %{HTTPS} on
    RewriteRule .* - [E=HTTP_X_FORWARDED_PROTO:https]

    # Reverse Proxy to local Node.js application port (Port 3000)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>


