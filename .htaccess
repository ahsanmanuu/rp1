# DO NOT REMOVE. CLOUDLINUX PASSED AGENT CONFIGURATION BEGIN
PassengerAppRoot "/home/latexify/latexify"
PassengerBaseURI "/"
PassengerNodejs "/home/latexify/nodevenv/latexify/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSED AGENT CONFIGURATION END

# LiteSpeed & Apache Configuration for Node.js Application
DirectoryIndex app.js app.cjs index.php

# Explicitly grant access permissions for LiteSpeed Web Server
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Protect sensitive environment and database files
<FilesMatch "^\.(env|git|cpanel|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Forward SSL protocol headers
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set X-Forwarded-Proto header for HTTPS connections
    RewriteCond %{HTTPS} on
    RewriteRule .* - [E=HTTP_X_FORWARDED_PROTO:https]
</IfModule>


