{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/template-migrator/layout,_N_T_/template-migrator/page,_N_T_/template-migrator"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/template-migrator/__PAGE__",
    "/template-migrator",
    "/_index",
    "/_head"
  ]
}